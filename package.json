{
  "name": "greenbump",
  "version": "0.1.0",
  "description": "Upgrade a dependency and let an AI agent fix the code it breaks — until CI is green. The Renovate that actually mends your code.",
  "type": "module",
  "bin": {
    "greenbump": "dist/cli.js"
  },
  "files": [
    "dist",
    "action-dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GH_USERNAME/greenbump.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GH_USERNAME/greenbump/issues"
  },
  "homepage": "https://github.com/YOUR_GH_USERNAME/greenbump#readme",
  "scripts": {
    "build": "tsc",
    "build:action": "npm run build && esbuild dist/action/main.js --bundle --platform=node --target=node20 --format=cjs --outfile=action-dist/index.cjs",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && cd dist && node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dependencies",
    "upgrade",
    "renovate",
    "dependabot",
    "ai",
    "agent",
    "claude",
    "automation",
    "codemod"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "commander": "^14.0.0",
    "openai": "^4.77.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
